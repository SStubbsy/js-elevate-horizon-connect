{
  "name": "js-elevate-horizon-connect",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed": "cd server && npm install && npm run seed",
    "start:server": "cd server && npm start",
    "dev": "concurrently \"npm run web\" \"npm run start:server\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.9.2",
    "expo": "~55.0.24",
    "expo-av": "^16.0.8",
    "expo-status-bar": "~55.0.6",
    "install": "^0.13.0",
    "npx": "^10.2.2",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-paper": "^5.15.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-web": "^0.21.2"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.1"
  }
}
